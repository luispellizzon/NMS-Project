# .env
# Environment variables for NMS-AI services
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
# =============================================================================
# REQUIRED: Gemini API Key (for AI Agents Service)
# =============================================================================
# Get your key from: https://ai.google.dev/
# This is used by the agents service for LLM capabilities
GEMINI_API_KEY=

# =============================================================================
# OLLAMA Configuration (Local LLM)
# =============================================================================
# Make sure Ollama is installed and running locally
# Install from: https://ollama.ai/
# Pull a model with: ollama pull llama3.2

# Ollama base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use (e.g., llama3.2, llama3.1, mistral, phi3, etc.)
# See available models: https://ollama.ai/library
OLLAMA_MODEL=

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Choose default LLM provider: "gemini" or "ollama"
# This will be used by default unless overridden in code
DEFAULT_LLM_PROVIDER=

# =============================================================================
# OPTIONAL: Additional LLM API Keys (for future use)
# =============================================================================
# Uncomment and add these if you want to use other LLM providers

# OpenAI API Key (if using GPT models)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (if using Claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here