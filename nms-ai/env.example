# .env
# Environment variables for NMS-AI services
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
# =============================================================================
# REQUIRED: Gemini API Key (for AI Agents Service)
# =============================================================================
# Get your key from: https://ai.google.dev/
# This is used by the agents service for LLM capabilities
GEMINI_API_KEY=

# =============================================================================
# OPTIONAL: Additional LLM API Keys (for future use)
# =============================================================================
# Uncomment and add these if you want to use other LLM providers

# OpenAI API Key (if using GPT models)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (if using Claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here