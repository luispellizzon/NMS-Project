# ===================================================================
#          .gitignore for the NeuroMind System AI Backend
# ===================================================================
# This file is organized by section for clarity.
# The most critical rules (secrets) are at the top.

# === Credentials & Secrets ===
# IMPORTANT: Never commit secrets, API keys, or credential files.
**/serviceAccountKey.json
serviceAccountKey.json
*.env
.env.*
*.pem
*.key
credentials.json
secrets.yaml

# === Python Virtual Environments ===
# Ignore virtual environment directories.
venv/
.venv/
env/
ENV/
venv.bak/
.env/

# === Python Artifacts & Caches ===
# Ignore Python cache files, compiled files, and distribution artifacts.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# === AI / Machine Learning - Models, Data, and Caches ===
# Ignore large model files, datasets, checkpoints, and logs.
# These should be downloaded or generated, not stored in Git.

# General Model & Data Folders
data/
datasets/
models/
saved_models/
checkpoints/
output/
outputs/

# Specific Model File Extensions
*.pt
*.pth
*.pb
*.h5
*.keras
*.onnx
*.pkl
*.pickle
*.joblib

# Whisper model caches
~/.cache/whisper/

# Local Ollama models (if stored within the project)
ollama_models/

# === IDE & Editor Configuration ===
# Ignore settings and workspace files from common editors.
.vscode/
.idea/
*.swp
*.swo
.sublime-project
.sublime-workspace

# === Testing & Coverage Reports ===
# Ignore artifacts generated by testing frameworks.
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
pytestdebug.log
.tox/

# === Operating System Specific Files ===
# Ignore files generated by macOS, Windows, and Linux.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# === Logs & Temporary Files ===
# Ignore log files and temporary directories.
*.log
logs/
log/
tmp/
temp/
*.tmp

# === Docker ===
# It's good practice to have a .dockerignore file, but sometimes
# local docker build cache or context files might appear.
.dockerignore

# === Jupyter Notebooks ===
# Ignore notebook checkpoints.
.ipynb_checkpoints